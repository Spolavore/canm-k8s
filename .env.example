# =============================================================================
# CANM — Cost Aware Node Migration
# Copie para `.env` e preencha com os valores do seu cluster.
# Formato de duração: apenas um sufixo por valor — `ms`, `s`, `m`, `h`.
# =============================================================================

# ----------------------------------------------------------------------------
# Cluster GKE
# ----------------------------------------------------------------------------

# Provider de cloud. Único valor suportado hoje: `gke`. Sem valor o CANM sai com exit 1.
EXTERNAL_PROVIDER=gke

# Nome do cluster GKE (obrigatório).
GKE_CLUSTER_NAME=

# ZONA do cluster, não região (ex.: us-central1-a). Clusters regionais não são
# suportados na etapa de ADDITION — ver docs/canm-vault/08 - Limitations.md.
GKE_REGION=

# Project ID do GCP (obrigatório).
GKE_PROJECT=

# Usa `--internal-ip` ao gerar o kubeconfig. Só a string minúscula `true` ativa.
GKE_INTERNAL_IP=false

# ----------------------------------------------------------------------------
# Prometheus — fonte das métricas de score
# ----------------------------------------------------------------------------

# Endpoint base do Prometheus, com barra final (ex.: http://prometheus.local:9090/).
PROMETHEUS_API_URL=

# Job que expõe as métricas de nó (container_cpu_usage_seconds_total,
# machine_cpu_cores, container_memory_working_set_bytes, machine_memory_bytes).
# Default no código: kubernetes-nodes-metrics
PROMETHEUS_JOB=

# ----------------------------------------------------------------------------
# Node pools
# ----------------------------------------------------------------------------

# Pool caro / alta performance — origem das migrações high->low (obrigatório).
HIGH_NODE_POOL=

# Pool barato / low-cost — origem das migrações low->high (obrigatório).
LOW_NODE_POOL=

# ----------------------------------------------------------------------------
# Thresholds de score (0.0–1.0)
# ----------------------------------------------------------------------------

# Score <= este valor no high pool torna o nó candidato a migrar para o low. Default: 0.3
LOW_SCORE_THRESHOLD=

# Score >= este valor no low pool torna o nó candidato a migrar para o high. Default: 0.7
# Entre os dois thresholds fica a zona segura: nenhuma migração.
HIGH_SCORE_THRESHOLD=

# ----------------------------------------------------------------------------
# Loop de operação
# ----------------------------------------------------------------------------

# Intervalo entre ticks (reconciliação + avaliação). Default: 1m
CHECK_INTERVAL=

# prioritizeCost avalia o high pool primeiro (busca ociosidade);
# prioritizePerformance avalia o low pool primeiro (busca sobrecarga).
# Default no código: prioritizePerformance
MIGRATION_POLICY=

# ----------------------------------------------------------------------------
# Cooldowns — evitam ping-pong (thrashing) entre pools
# ----------------------------------------------------------------------------

# Tempo em que um nó recém-criado no high pool é ignorado na avaliação. Default: 5m
HIGH_NODE_COOL_DOWN=

# Idem para o low pool. Default: 5m
LOW_NODE_COOL_DOWN=

# ----------------------------------------------------------------------------
# Janelas de avaliação — range do rate() nas queries PromQL
# ----------------------------------------------------------------------------

# Janela do score do low pool. Janela curta reage mais rápido à sobrecarga. Default: 10m
LOW_POOL_TIME_WINDOW_EVAL=

# Janela do score do high pool. Janela longa evita migrar por pico curto. Default: 10m
HIGH_POOL_TIME_WINDOW_EVAL=

# ----------------------------------------------------------------------------
# Pesos do score composto
# ----------------------------------------------------------------------------

# score = (cpu% * pesoCpu + mem% * pesoMem) / 100
# Os pesos são normalizados para somar 1.0 — só o rácio entre eles importa.
# Defaults: CPU 0.6 / MEM 0.3
CPU_WEIGHT=
MEMORY_WEIGHT=

# ----------------------------------------------------------------------------
# Drain
# ----------------------------------------------------------------------------

# Drain pausado por lotes via Eviction API (respeita PDB) no lugar do
# `kubectl drain` one-shot. Só a string MAIÚSCULA `TRUE` ativa. Default: desligado.
DRAIN_PACED=

# Pods evacuados por lote quando DRAIN_PACED=TRUE. Default: 10
DRAIN_BATCH_SIZE=

# Espera fixa entre lotes — tempo para o lote aquecer no nó destino. Default: 5m
# Duração total do drain ~= (nº de lotes - 1) * este valor.
DRAIN_BATCH_INTERVAL=

# ----------------------------------------------------------------------------
# Remoção
# ----------------------------------------------------------------------------

# Espera entre o fim do drain e o delete do nó origem, dando tempo para o
# tráfego drenar das conexões abertas. Sem valor, a remoção é imediata.
REMOVE_SETTLE=

# ----------------------------------------------------------------------------
# Debug
# ----------------------------------------------------------------------------

# Loga o raciocínio de decisão de cada tick. Atenção: qualquer valor não-vazio
# ativa (inclusive `false`) — deixe em branco para desligar.
SHOW_DECISIONS_LOGS=
